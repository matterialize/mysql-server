# A read view older than the clone cannot follow roll pointers into
# undo written for the source table: it gets ER_TABLE_DEF_CHANGED.
CREATE DATABASE src;
CREATE TABLE src.t (id INT PRIMARY KEY, v INT);
INSERT INTO src.t VALUES (1, 1), (2, 2);
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT * FROM src.t ORDER BY id;
id	v
1	1
2	2
UPDATE src.t SET v = 100 WHERE id = 1;
CREATE WORKTREE wt FROM src;
SELECT * FROM wt.t;
ERROR HY000: Table definition has changed, please retry transaction
SELECT * FROM src.t ORDER BY id;
id	v
1	1
2	2
COMMIT;
SELECT * FROM wt.t ORDER BY id;
id	v
1	100
2	2
# A writer holding a source table delays the clone (MDL SNW) until it ends.
BEGIN;
INSERT INTO src.t VALUES (3, 3);
SET SESSION lock_wait_timeout = 1;
CREATE WORKTREE wt2 FROM src;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
SHOW DATABASES LIKE 'wt2';
Database (wt2)
COMMIT;
SET SESSION lock_wait_timeout = DEFAULT;
CREATE WORKTREE wt2 FROM src;
SELECT * FROM wt2.t ORDER BY id;
id	v
1	100
2	2
3	3
DROP DATABASE wt;
DROP DATABASE wt2;
DROP DATABASE src;
