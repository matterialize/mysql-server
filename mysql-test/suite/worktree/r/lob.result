# LOB pages are located through the index's tablespace, never the
# (ancestor) space id stored in the LOB reference.
CREATE DATABASE src;
CREATE TABLE src.d (id INT PRIMARY KEY, t LONGTEXT, b LONGBLOB, j JSON);
INSERT INTO src.d VALUES
(1, REPEAT('a', 100000), REPEAT('A', 300000), JSON_OBJECT('k', REPEAT('j', 50000))),
(2, REPEAT('b', 20000),  NULL,                JSON_ARRAY(1,2,3)),
(3, 'short',             REPEAT('C', 9000),   JSON_OBJECT('k', REPEAT('q', 30000)));
CREATE WORKTREE wt FROM src;
SELECT id, LENGTH(t), LENGTH(b), LENGTH(j->>'$.k'), SHA2(t, 256), SHA2(b, 256) FROM wt.d ORDER BY id;
id	LENGTH(t)	LENGTH(b)	LENGTH(j->>'$.k')	SHA2(t, 256)	SHA2(b, 256)
1	100000	300000	50000	6d1cf22d7cc09b085dfc25ee1a1f3ae0265804c607bc2074ad253bcc82fd81ee	3cdc92c3d725c404c8cfaa26d17a7ff0420dac1c5fc5a837c8d819f07a9ee698
2	20000	NULL	NULL	49a82a41772cfafe8b77be495a8d2fea49cd67100810a2911c12b524d6bf8b51	NULL
3	5	9000	30000	f9b0078b5df596d2ea19010c001bbd009e651de2c57e8fb7e355f31eb9d3f739	9a29b95d0bc0bee02c95c25b89f5ac508e4b9588acaa38a05037e1e6c679e015
# Rewrite, partially update, and delete LOBs in the worktree.
UPDATE wt.d SET t = REPEAT('x', 120000) WHERE id = 1;
UPDATE wt.d SET j = JSON_SET(j, '$.k', 'tiny') WHERE id = 3;
UPDATE wt.d SET b = CONCAT(b, 'tail') WHERE id = 1;
DELETE FROM wt.d WHERE id = 2;
INSERT INTO wt.d VALUES (4, REPEAT('n', 70000), REPEAT('N', 70000), NULL);
# And in the source.
UPDATE src.d SET b = REPEAT('S', 250000) WHERE id = 3;
DELETE FROM src.d WHERE id = 1;
# Purge frees the old LOB pages on each side, in its own file.
SET GLOBAL innodb_purge_run_now = ON;
SELECT id, LENGTH(t), LENGTH(b), LENGTH(j->>'$.k'), SHA2(t, 256), SHA2(b, 256) FROM src.d ORDER BY id;
id	LENGTH(t)	LENGTH(b)	LENGTH(j->>'$.k')	SHA2(t, 256)	SHA2(b, 256)
2	20000	NULL	NULL	49a82a41772cfafe8b77be495a8d2fea49cd67100810a2911c12b524d6bf8b51	NULL
3	5	250000	30000	f9b0078b5df596d2ea19010c001bbd009e651de2c57e8fb7e355f31eb9d3f739	ef6725b50ac7be2977ac0b2b07cfb03dc1ca1b9d831e29b66f992518e8b70dff
SELECT id, LENGTH(t), LENGTH(b), LENGTH(j->>'$.k'), SHA2(t, 256), SHA2(b, 256) FROM wt.d ORDER BY id;
id	LENGTH(t)	LENGTH(b)	LENGTH(j->>'$.k')	SHA2(t, 256)	SHA2(b, 256)
1	120000	300004	50000	8d07e6cc2b317afddd43027a1e78d9e35944643918163eb194ae4017955b03ff	18566ca9b98710b3f40aadbd8bc4bcefd13e9373e7222567ab2270758fd88a9c
3	5	9000	4	f9b0078b5df596d2ea19010c001bbd009e651de2c57e8fb7e355f31eb9d3f739	9a29b95d0bc0bee02c95c25b89f5ac508e4b9588acaa38a05037e1e6c679e015
4	70000	70000	NULL	16c2d8d226a6110be284ff8493fbdfa379734f4249d25aa8388fca767da8eb88	9a8f7406b9756e056828958d592b1255ff7a21be0839563a28719a2356575685
CHECK TABLE src.d, wt.d;
Table	Op	Msg_type	Msg_text
src.d	check	status	OK
wt.d	check	status	OK
# restart
SELECT id, LENGTH(t), LENGTH(b), SHA2(t, 256), SHA2(b, 256) FROM src.d ORDER BY id;
id	LENGTH(t)	LENGTH(b)	SHA2(t, 256)	SHA2(b, 256)
2	20000	NULL	49a82a41772cfafe8b77be495a8d2fea49cd67100810a2911c12b524d6bf8b51	NULL
3	5	250000	f9b0078b5df596d2ea19010c001bbd009e651de2c57e8fb7e355f31eb9d3f739	ef6725b50ac7be2977ac0b2b07cfb03dc1ca1b9d831e29b66f992518e8b70dff
SELECT id, LENGTH(t), LENGTH(b), SHA2(t, 256), SHA2(b, 256) FROM wt.d ORDER BY id;
id	LENGTH(t)	LENGTH(b)	SHA2(t, 256)	SHA2(b, 256)
1	120000	300004	8d07e6cc2b317afddd43027a1e78d9e35944643918163eb194ae4017955b03ff	18566ca9b98710b3f40aadbd8bc4bcefd13e9373e7222567ab2270758fd88a9c
