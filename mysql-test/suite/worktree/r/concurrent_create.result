# Concurrent CREATE WORKTREE from one source: none deadlocks. Each create
# used to take S then IX on the source schema, so two creates holding S
# waited on each other's IX (ERROR 1213 for all but two of them).
CREATE DATABASE g;
CREATE TABLE g.p (id INT PRIMARY KEY, v INT) ENGINE = InnoDB;
CREATE TABLE g.c (id INT PRIMARY KEY, p_id INT, KEY (p_id),
FOREIGN KEY (p_id) REFERENCES g.p (id)) ENGINE = InnoDB;
CREATE TABLE g.l (id INT PRIMARY KEY, b LONGBLOB) ENGINE = InnoDB;
INSERT INTO g.p VALUES (1, 10), (2, 20), (3, 30), (4, 40);
INSERT INTO g.c VALUES (1, 1), (2, 2), (3, 4);
INSERT INTO g.l VALUES (1, REPEAT('x', 100000));
CREATE VIEW g.v AS SELECT SUM(v) AS s FROM g.p;
CREATE PROCEDURE g.move(n INT)
BEGIN
DECLARE i INT DEFAULT 0;
WHILE i < n DO
START TRANSACTION;
UPDATE p SET v = v - 1 WHERE id = 1 + i % 4;
UPDATE p SET v = v + 1 WHERE id = 1 + (i + 1) % 4;
COMMIT;
SET i = i + 1;
END WHILE;
END|
#
# 1. Read-only source: 8 creates at once all succeed.
ALTER SCHEMA g READ ONLY = 1;
SELECT COUNT(*) AS read_only_worktrees FROM information_schema.schemata
WHERE schema_name LIKE 'ro%';
read_only_worktrees
8
INSERT INTO ro1.c VALUES (4, 3);
INSERT INTO ro2.c VALUES (4, 9);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails (`ro2`.`c`, CONSTRAINT `c_ibfk_1` FOREIGN KEY (`p_id`) REFERENCES `p` (`id`))
SELECT (SELECT COUNT(*) FROM ro1.c), (SELECT COUNT(*) FROM ro2.c),
(SELECT COUNT(*) FROM g.c);
(SELECT COUNT(*) FROM ro1.c)	(SELECT COUNT(*) FROM ro2.c)	(SELECT COUNT(*) FROM g.c)
4	3	3
#
# 2. Writable source under writes: 8 creates at once all succeed, each
#    sees a committed state (the writer keeps SUM(v) at 100).
ALTER SCHEMA g READ ONLY = 0;
CALL move(3000);
SELECT COUNT(*) AS writable_source_worktrees FROM information_schema.schemata
WHERE schema_name LIKE 'rw%';
writable_source_worktrees
8
SELECT s FROM g.v;
s
100
CHECK TABLE rw1.p, rw1.c, rw1.l, rw8.p, rw8.c, rw8.l;
Table	Op	Msg_type	Msg_text
rw1.p	check	status	OK
rw1.c	check	status	OK
rw1.l	check	status	OK
rw8.p	check	status	OK
rw8.c	check	status	OK
rw8.l	check	status	OK
#
# 3. Mixed: creates from a worktree and from its source at once.
SELECT COUNT(*) AS mixed_worktrees FROM information_schema.schemata
WHERE schema_name LIKE 'mx%';
mixed_worktrees
8
SELECT (SELECT COUNT(*) FROM mx1.c), (SELECT COUNT(*) FROM mx8.c);
(SELECT COUNT(*) FROM mx1.c)	(SELECT COUNT(*) FROM mx8.c)
4	3
DROP DATABASE g;
