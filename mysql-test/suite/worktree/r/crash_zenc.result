CREATE WORKTREE wt FROM src;
ERROR HY000: Lost connection to MySQL server during query
# restart
SHOW DATABASES LIKE 'wt';
Database (wt)
# no schema directory, no clone files
SELECT COUNT(*) FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE 'wt/%';
COUNT(*)
0
CHECK TABLE src.z1, src.enc, src.encz;
Table	Op	Msg_type	Msg_text
src.z1	check	status	OK
src.enc	check	status	OK
src.encz	check	status	OK
CHECKSUM TABLE src.z1, src.enc, src.encz;
Table	Checksum
src.z1	2262705519
src.enc	3657261927
src.encz	2262705519
# Crash right after the commit: the worktree is complete.
SET SESSION debug = '+d,wt_crash_after_commit';
CREATE WORKTREE wt FROM src;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT NAME, ENCRYPTION, ROW_FORMAT FROM INFORMATION_SCHEMA.INNODB_TABLESPACES WHERE NAME LIKE 'wt/%' ORDER BY NAME;
NAME	ENCRYPTION	ROW_FORMAT
wt/enc	Y	Dynamic
wt/encz	Y	Compressed
wt/z1	N	Compressed
CHECKSUM TABLE wt.z1, wt.enc, wt.encz;
Table	Checksum
wt.z1	2262705519
wt.enc	3657261927
wt.encz	2262705519
CHECK TABLE wt.z1, wt.enc, wt.encz;
Table	Op	Msg_type	Msg_text
wt.z1	check	status	OK
wt.enc	check	status	OK
wt.encz	check	status	OK
SELECT COUNT(*) FROM wt.encz FORCE INDEX (b) WHERE b LIKE 'b1%';
COUNT(*)
1111
INSERT INTO wt.encz VALUES (5000, 1, 'wt', 1);
UPDATE wt.z1 SET b = 'wt' WHERE id = 1;
# restart
CHECK TABLE wt.z1, wt.enc, wt.encz, src.z1, src.encz;
Table	Op	Msg_type	Msg_text
wt.z1	check	status	OK
wt.enc	check	status	OK
wt.encz	check	status	OK
src.z1	check	status	OK
src.encz	check	status	OK
SELECT COUNT(*) FROM src.encz WHERE b = 'wt';
COUNT(*)
0
SELECT COUNT(*) FROM wt.encz WHERE b = 'wt';
COUNT(*)
1
SELECT b FROM src.z1 WHERE id = 1;
b
b1
SELECT b FROM wt.z1 WHERE id = 1;
b
wt
DROP DATABASE wt;
DROP DATABASE src;
