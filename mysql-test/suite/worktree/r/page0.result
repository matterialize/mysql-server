# Page 0 is no longer a single point of failure (fork-design.md §12.1 H5,
# §10.1 item 4): the ancestor map has a copy in page 1 that names the
# file's own space id, and startup never identifies a worktree file as
# its ancestor.
call mtr.add_suppression("Worktree map in page 0 of tablespace wt/big is damaged");
call mtr.add_suppression("Header page consists of zero bytes in datafile: ./(wt|src)/big.ibd");
SET SESSION cte_max_recursion_depth = 100000;
CREATE DATABASE src;
CREATE TABLE src.big (id INT PRIMARY KEY, pad CHAR(200));
INSERT INTO src.big WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 900) SELECT n, 'x' FROM s;
#
# A. The map in page 0 is garbled (page checksum re-stamped, so only the
#    map's own CRC catches it): the copy in page 1 is used.
CREATE WORKTREE wt FROM src;
UPDATE wt.big SET pad = 'wt' WHERE id = 1;
SET GLOBAL innodb_fast_shutdown = 0;
# restart
SELECT COUNT(*), SUM(id), MAX(pad) FROM wt.big;
COUNT(*)	SUM(id)	MAX(pad)
900	405450	x
SELECT COUNT(*), MAX(pad) FROM src.big;
COUNT(*)	MAX(pad)
900	x
CHECK TABLE wt.big;
Table	Op	Msg_type	Msg_text
wt.big	check	status	OK
Pattern "Worktree map in page 0 of tablespace wt/big is damaged; using the copy in page 1" found
DROP DATABASE wt;
#
# B. Page 0 is lost (zeroed) after a crash: startup identifies the file by
#    the copy in page 1 and restores the worktree's own page 0 from the
#    doublewrite buffer.
CREATE WORKTREE wt FROM src;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO wt.big WITH RECURSIVE s(n) AS (SELECT 1000 UNION ALL SELECT n + 1 FROM s WHERE n < 9000) SELECT n, 'y' FROM s;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE wt.big SET pad = 'after-checkpoint' WHERE id = 5;
# Kill the server
# restart: --log-error-verbosity=3
SELECT COUNT(*), MAX(id) FROM wt.big;
COUNT(*)	MAX(id)
8901	9000
SELECT pad FROM wt.big WHERE id = 5;
pad
after-checkpoint
SELECT COUNT(*) FROM src.big;
COUNT(*)
900
CHECK TABLE wt.big, src.big;
Table	Op	Msg_type	Msg_text
wt.big	check	status	OK
src.big	check	status	OK
Pattern "Datafile './wt/big.ibd' is a worktree; its own space id [0-9]+ is taken from page 1" found
Pattern "Restoring page \[page id: space=[0-9]+, page number=0\] of datafile './wt/big.ibd' from the doublewrite buffer" found
page 0 of the worktree is its own: yes
DROP DATABASE wt;
#
# C. Pages 0 and 1 are both lost and nearly every page still carries the
#    ancestor's id, with the ancestor's page 0 in the doublewrite buffer.
#    A plain majority vote would pick the ancestor and restore its page 0
#    into the worktree's file; instead the vote refuses the ancestor and
#    startup stops with the file unidentified.
CREATE WORKTREE wt FROM src;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO src.big WITH RECURSIVE s(n) AS (SELECT 1000 UNION ALL SELECT n + 1 FROM s WHERE n < 9000) SELECT n, 'y' FROM s;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE wt.big SET pad = 'after-checkpoint' WHERE id = 5;
# Kill the server
Pattern "(Datafile './wt/big.ibd': space id [0-9]+ (belongs to another file|is a worktree ancestor and this is not its file); not chosen|Header page consists of zero bytes in datafile: ./wt/big.ibd)" found
Pattern "(Could not find any file associated with the tablespace ID|could not be found in the doublewrite buffer)" found
source page 0 written into the worktree: no
# Put the file back; recovery then completes normally.
# restart
SELECT pad FROM wt.big WHERE id = 5;
pad
after-checkpoint
CHECK TABLE wt.big;
Table	Op	Msg_type	Msg_text
wt.big	check	status	OK
DROP DATABASE wt;
#
# D. Page 0 lost after a clean shutdown (nothing in the doublewrite
#    buffer): unrecoverable, exactly as for a stock table. Stock InnoDB
#    either reports such a tablespace missing or stops with "Tablespace id
#    is N in the data dictionary but in file ... it is 0" on first access
#    (also when the buffer pool dump is loaded), so the table is not
#    touched here. What a worktree must add: the server starts, the source
#    is unaffected, and the worktree's page 0 is never replaced.
CREATE WORKTREE wt FROM src;
SET GLOBAL innodb_fast_shutdown = 0;
# restart: --innodb-buffer-pool-load-at-startup=OFF
SELECT COUNT(*) FROM src.big;
COUNT(*)
8901
CHECK TABLE src.big;
Table	Op	Msg_type	Msg_text
src.big	check	status	OK
page 0 of the worktree is still all zero: yes
# restart
SELECT COUNT(*) FROM wt.big;
COUNT(*)
8901
DROP DATABASE wt;
#
# E. The source's own torn page 0 is still restored from the doublewrite
#    buffer, as in stock: #wt_ancestors records ./src/big.ibd as the
#    file of space 2's id, so the vote may pick it for that file.
CREATE WORKTREE wt FROM src;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO src.big WITH RECURSIVE s(n) AS (SELECT 20000 UNION ALL SELECT n + 1 FROM s WHERE n < 28000) SELECT n, 'z' FROM s;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE src.big SET pad = 'src-after-checkpoint' WHERE id = 5;
# Kill the server
# restart: --log-error-verbosity=3
SELECT pad FROM src.big WHERE id = 5;
pad
src-after-checkpoint
SELECT COUNT(*) FROM src.big;
COUNT(*)
16902
CHECK TABLE src.big, wt.big;
Table	Op	Msg_type	Msg_text
src.big	check	status	OK
wt.big	check	status	OK
Pattern "Restoring page \[page id: space=[0-9]+, page number=0\] of datafile './src/big.ibd' from the doublewrite buffer" found
#
# F. As C, but the source is dropped first, so no other file claims its
#    id: the vote still never picks the ancestor (#wt_ancestors), and the
#    ancestor's page 0 is not written into the worktree.
INSERT INTO src.big VALUES (99999, 'last');
SET GLOBAL innodb_log_checkpoint_now = ON;
DROP DATABASE src;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE wt.big SET pad = 'wt-after-drop' WHERE id = 5;
# Kill the server
Pattern "(Datafile './wt/big.ibd': space id [0-9]+ is a worktree ancestor and this is not its file; not chosen|could not be found in the doublewrite buffer)" found
pages 0 and 1 of the worktree are still all zero: yes
# restart
SELECT pad FROM wt.big WHERE id = 5;
pad
wt-after-drop
CHECK TABLE wt.big;
Table	Op	Msg_type	Msg_text
wt.big	check	status	OK
DROP DATABASE wt;
#
# G. A 1 KB compressed worktree's page 0 lost after a crash. Compressed
#    page 1 has no map area (the change buffer writes past the bitmap's
#    physical extent there, as stock does), so the file is identified by
#    InnoDB's page vote. Whatever the vote makes of it (it may restore
#    the worktree's own page 0, or stop with the file unidentified), it
#    never restores the source's page 0 into the worktree.
call mtr.add_suppression("Header page consists of zero bytes in datafile: ./wz/zc.ibd");
CREATE DATABASE src;
CREATE TABLE src.zc (id INT PRIMARY KEY, v VARCHAR(40), KEY (v)) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=1;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO src.zc WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 3000) SELECT n, CONCAT('z', n) FROM s;
CREATE WORKTREE wz FROM src;
INSERT INTO wz.zc WITH RECURSIVE s(n) AS (SELECT 10001 UNION ALL SELECT n + 1 FROM s WHERE n < 16000) SELECT n, 'grown' FROM s;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE wz.zc SET v = 'after-checkpoint' WHERE id = 5;
# Kill the server
source page 0 written into the compressed worktree: no
# restart
SELECT COUNT(*), SUM(v = 'grown') FROM wz.zc;
COUNT(*)	SUM(v = 'grown')
9000	6000
CHECK TABLE wz.zc, src.zc;
Table	Op	Msg_type	Msg_text
wz.zc	check	status	OK
src.zc	check	status	OK
DROP DATABASE wz;
DROP DATABASE src;
