# If the remap cannot run (here: its lock fails), PREPARE fails rather
# than running the statement unremapped against the source.
# Calls in an ordinary schema never take that path.
CALL src.p_dyn(@s);
SELECT @s;
@s
3
# Top-level dynamic SQL is never remapped.
USE wt;
SET @q = 'SELECT COUNT(*) FROM src.t';
PREPARE s FROM @q;
EXECUTE s;
COUNT(*)
3
DEALLOCATE PREPARE s;
USE test;
# A worktree of a worktree remaps wt. to wt2.
CREATE WORKTREE wt2 FROM wt;
SHOW CREATE VIEW wt2.v1;
