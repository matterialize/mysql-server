# DDL on overlays (limits/overlay-v3.md §5.3 rows 2-3, §6.4 "CREATE INDEX",
# §11.14): a bulk-built index (no redo for its pages) on an overlay is read
# before and after a restart; kill -9 before and after its DDL commit.
# Debug asserts check that no page of the new index is ever read from the
# layer (written ones are PRESENT, never a hole).
SET SESSION cte_max_recursion_depth = 100000;
CREATE DATABASE src;
CREATE TABLE src.t (id INT PRIMARY KEY, a INT, v VARCHAR(100));
INSERT INTO src.t WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 20000)
SELECT n, n % 97, CONCAT('row', n) FROM s;
CREATE WORKTREE wt FROM src;
#
# 1. CREATE INDEX on an overlay: read through the new index at once, and
#    after a restart (its pages are fsynced locally before the commit).
UPDATE wt.t SET a = 1000 WHERE id <= 30;
ALTER TABLE wt.t ADD INDEX ka (a), ALGORITHM = INPLACE;
SELECT COUNT(*) FROM wt.t FORCE INDEX (ka) WHERE a = 1000;
COUNT(*)
30
SELECT COUNT(*) FROM wt.t FORCE INDEX (ka) WHERE a < 97;
COUNT(*)
19970
# restart
SELECT COUNT(*) FROM wt.t FORCE INDEX (ka) WHERE a = 1000;
COUNT(*)
30
CHECK TABLE wt.t;
Table	Op	Msg_type	Msg_text
wt.t	check	status	OK
#
# 2. kill -9 after the bulk build, before its DDL commit (the stock sync
#    point after the in-place build), and right before and after the
#    commit: the index is either absent or complete.
UPDATE wt.t SET v = 'd0' WHERE id % 50 = 0;
SET DEBUG_SYNC = 'innodb_after_inplace_alter_table SIGNAL built WAIT_FOR never';
ALTER TABLE wt.t ADD INDEX kv0 (v), ALGORITHM = INPLACE;
SET DEBUG_SYNC = 'now WAIT_FOR built';
# Kill the server
# restart
SELECT COUNT(*) AS has_index FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'wt' AND TABLE_NAME = 't' AND INDEX_NAME = 'kv0';
has_index
0
SELECT COUNT(*), SUM(v = 'd0') FROM wt.t;
COUNT(*)	SUM(v = 'd0')
20000	400
CHECK TABLE wt.t;
Table	Op	Msg_type	Msg_text
wt.t	check	status	OK
UPDATE wt.t SET v = 'd1' WHERE id % 50 = 0;
SET SESSION debug = '+d,crash_commit_before';
ALTER TABLE wt.t ADD INDEX kv1 (v), ALGORITHM = INPLACE;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT 'crash_commit_before' AS point, COUNT(*) AS has_index FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'wt' AND TABLE_NAME = 't' AND INDEX_NAME = 'kv1';
point	has_index
crash_commit_before	0
SELECT COUNT(*), SUM(v = 'd1') FROM wt.t;
COUNT(*)	SUM(v = 'd1')
20000	400
CHECK TABLE wt.t;
Table	Op	Msg_type	Msg_text
wt.t	check	status	OK
UPDATE wt.t SET v = 'd2' WHERE id % 50 = 0;
SET SESSION debug = '+d,crash_commit_after';
ALTER TABLE wt.t ADD INDEX kv2 (v), ALGORITHM = INPLACE;
ERROR HY000: Lost connection to MySQL server during query
# restart
SELECT 'crash_commit_after' AS point, COUNT(*) AS has_index FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'wt' AND TABLE_NAME = 't' AND INDEX_NAME = 'kv2';
point	has_index
crash_commit_after	0
SELECT COUNT(*), SUM(v = 'd2') FROM wt.t;
COUNT(*)	SUM(v = 'd2')
20000	400
CHECK TABLE wt.t;
Table	Op	Msg_type	Msg_text
wt.t	check	status	OK
#
# 3. An in-place rebuild of an overlay (a new standalone file) and an
#    instant ADD COLUMN on one.
CREATE WORKTREE wt2 FROM src;
UPDATE wt2.t SET v = 'rebuilt' WHERE id <= 10;
ALTER TABLE wt2.t ENGINE = InnoDB, ALGORITHM = INPLACE;
SELECT FLAG & 32768 AS overlay_bit FROM INFORMATION_SCHEMA.INNODB_TABLESPACES WHERE NAME = 'wt2/t';
overlay_bit
0
ALTER TABLE wt.t ADD COLUMN c INT DEFAULT 7, ALGORITHM = INSTANT;
# restart
SELECT COUNT(*), SUM(v = 'rebuilt') FROM wt2.t;
COUNT(*)	SUM(v = 'rebuilt')
20000	10
SELECT COUNT(*), SUM(c) FROM wt.t;
COUNT(*)	SUM(c)
20000	140000
CHECK TABLE wt.t, wt2.t, src.t;
Table	Op	Msg_type	Msg_text
wt.t	check	status	OK
wt2.t	check	status	OK
src.t	check	status	OK
DROP DATABASE wt2;
DROP DATABASE wt;
DROP DATABASE src;
SHOW GLOBAL STATUS LIKE 'Innodb_worktree_layers';
Variable_name	Value
Innodb_worktree_layers	0
