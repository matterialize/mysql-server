# CREATE WORKTREE locking: creates from a read-only source run in parallel;
# creates from a writable source wait their turn instead of deadlocking.
CREATE DATABASE g;
CREATE TABLE g.t (id INT PRIMARY KEY, v INT) ENGINE = InnoDB;
INSERT INTO g.t VALUES (1, 1), (2, 2);
#
# 1. Read-only source: with one create paused holding its source locks,
#    two more from the same source complete.
ALTER SCHEMA g READ ONLY = 1;
SET DEBUG_SYNC = 'wt_create_after_source_lock SIGNAL held WAIT_FOR go';
CREATE WORKTREE a1 FROM g;
SET DEBUG_SYNC = 'now WAIT_FOR held';
CREATE WORKTREE a2 FROM g;
CREATE WORKTREE a3 FROM g;
SELECT * FROM a3.t ORDER BY id;
id	v
1	1
2	2
SET DEBUG_SYNC = 'now SIGNAL go';
SELECT * FROM a1.t ORDER BY id;
id	v
1	1
2	2
#
# 2. Writable source: the second and third creates wait for the first
#    (for its turn), then succeed.
ALTER SCHEMA g READ ONLY = 0;
SET DEBUG_SYNC = 'wt_create_after_source_lock SIGNAL held WAIT_FOR go';
CREATE WORKTREE b1 FROM g;
SET DEBUG_SYNC = 'now WAIT_FOR held';
CREATE WORKTREE b2 FROM g;
CREATE WORKTREE b3 FROM g;
SET DEBUG_SYNC = 'now SIGNAL go';
SELECT COUNT(*) AS writable_source_worktrees FROM information_schema.schemata
WHERE schema_name LIKE 'b%';
writable_source_worktrees
3
#
# 3. A read-only create racing ALTER SCHEMA READ ONLY = 0: the ALTER
#    waits for the create's IX lock; the create finishes on the
#    read-only state.
ALTER SCHEMA g READ ONLY = 1;
SET DEBUG_SYNC = 'wt_create_after_source_lock SIGNAL held WAIT_FOR go';
CREATE WORKTREE c1 FROM g;
SET DEBUG_SYNC = 'now WAIT_FOR held';
ALTER SCHEMA g READ ONLY = 0;
SET DEBUG_SYNC = 'now SIGNAL go';
SELECT * FROM c1.t ORDER BY id;
id	v
1	1
2	2
SELECT schema_name, options FROM information_schema.schemata_extensions
WHERE schema_name = 'g';
SCHEMA_NAME	OPTIONS
g	
#
# 4. Writable source, create paused holding its source locks: CREATE
#    TABLE in the source still runs (the worktree has the tables as of
#    the lock), a writer waits for the create instead of deadlocking.
ALTER SCHEMA g READ ONLY = 0;
SET DEBUG_SYNC = 'wt_create_after_source_lock SIGNAL held WAIT_FOR go';
CREATE WORKTREE d1 FROM g;
SET DEBUG_SYNC = 'now WAIT_FOR held';
CREATE TABLE g.n (id INT PRIMARY KEY);
UPDATE g.t SET v = v + 10;
SET DEBUG_SYNC = 'now SIGNAL go';
SHOW TABLES FROM d1;
Tables_in_d1
t
SELECT * FROM d1.t ORDER BY id;
id	v
1	1
2	2
SELECT * FROM g.t ORDER BY id;
id	v
1	11
2	12
#
# 5. Writable source, create paused holding its source locks: views,
#    routines and events of the source are dropped and replaced
#    meanwhile. The worktree gets the objects as the create listed them.
CREATE VIEW g.v AS SELECT id FROM g.t;
CREATE VIEW g.v2 AS SELECT v FROM g.t;
CREATE FUNCTION g.f() RETURNS INT DETERMINISTIC RETURN 1;
CREATE PROCEDURE g.p() SELECT 1;
CREATE EVENT g.e ON SCHEDULE EVERY 1 DAY DISABLE DO SELECT 1;
SET DEBUG_SYNC = 'wt_create_after_source_lock SIGNAL held WAIT_FOR go';
CREATE WORKTREE e1 FROM g;
SET DEBUG_SYNC = 'now WAIT_FOR held';
DROP VIEW g.v;
CREATE OR REPLACE VIEW g.v2 AS SELECT id + 100 AS x FROM g.t;
DROP FUNCTION g.f;
CREATE FUNCTION g.f() RETURNS INT DETERMINISTIC RETURN 2;
DROP PROCEDURE g.p;
DROP EVENT g.e;
SET DEBUG_SYNC = 'now SIGNAL go';
SELECT TABLE_NAME, VIEW_DEFINITION FROM information_schema.views
WHERE TABLE_SCHEMA = 'e1' ORDER BY TABLE_NAME;
TABLE_NAME	VIEW_DEFINITION
v	select `e1`.`t`.`id` AS `id` from `e1`.`t`
v2	select `e1`.`t`.`v` AS `v` from `e1`.`t`
SELECT ROUTINE_NAME, ROUTINE_DEFINITION FROM information_schema.routines
WHERE ROUTINE_SCHEMA = 'e1' ORDER BY ROUTINE_NAME;
ROUTINE_NAME	ROUTINE_DEFINITION
f	RETURN 1
p	SELECT 1
SELECT EVENT_NAME, STATUS FROM information_schema.events WHERE EVENT_SCHEMA = 'e1';
EVENT_NAME	STATUS
e	DISABLED
SELECT * FROM e1.v ORDER BY id;
id
1
2
SELECT e1.f();
e1.f()
1
CALL e1.p();
1
1
SET DEBUG_SYNC = 'RESET';
DROP DATABASE a1;
DROP DATABASE a2;
DROP DATABASE a3;
DROP DATABASE b1;
DROP DATABASE b2;
DROP DATABASE b3;
DROP DATABASE c1;
DROP DATABASE d1;
DROP DATABASE e1;
DROP DATABASE g;
