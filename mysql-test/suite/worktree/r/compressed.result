# Every page on disk, shared or not, still has a valid checksum.
# restart
# A worktree of the worktree: a longer chain, still overflow at 1 KB.
CREATE WORKTREE wt2 FROM wt;
CHECKSUM TABLE wt.z1, wt.z1_small, wt.z4;
