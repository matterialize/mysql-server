# ROW_FORMAT=COMPRESSED (fork-design.md §10.4): clones keep sharing every
# data page. Pages are translated after their checksum is validated, in
# both copies (compressed and uncompressed frame). At KEY_BLOCK_SIZE=1
# page 0 has room for about one index, so larger maps go to overflow
# pages taken from the file's own allocator.
SET SESSION cte_max_recursion_depth = 100000;
CREATE DATABASE src;
# One table per KEY_BLOCK_SIZE, several indexes and BLOBs each.
CREATE TABLE src.z1 (id INT PRIMARY KEY, a INT, b VARCHAR(40), c VARCHAR(40), d INT, blb BLOB,
KEY ka (a), KEY kb (b), KEY kc (c, d)) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=1;
INSERT INTO src.z1 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 3000)
SELECT n, n % 97, CONCAT('b', n), CONCAT('c', n % 13), n * 3, IF(n % 100 = 0, REPEAT(CONCAT('lob', n), 3000), NULL) FROM s;
CREATE TABLE src.z2 (id INT PRIMARY KEY, a INT, b VARCHAR(40), c VARCHAR(40), d INT, blb BLOB,
KEY ka (a), KEY kb (b), KEY kc (c, d)) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=2;
INSERT INTO src.z2 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 3000)
SELECT n, n % 97, CONCAT('b', n), CONCAT('c', n % 13), n * 3, IF(n % 100 = 0, REPEAT(CONCAT('lob', n), 3000), NULL) FROM s;
CREATE TABLE src.z4 (id INT PRIMARY KEY, a INT, b VARCHAR(40), c VARCHAR(40), d INT, blb BLOB,
KEY ka (a), KEY kb (b), KEY kc (c, d)) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=4;
INSERT INTO src.z4 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 3000)
SELECT n, n % 97, CONCAT('b', n), CONCAT('c', n % 13), n * 3, IF(n % 100 = 0, REPEAT(CONCAT('lob', n), 3000), NULL) FROM s;
CREATE TABLE src.z8 (id INT PRIMARY KEY, a INT, b VARCHAR(40), c VARCHAR(40), d INT, blb BLOB,
KEY ka (a), KEY kb (b), KEY kc (c, d)) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=8;
INSERT INTO src.z8 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 3000)
SELECT n, n % 97, CONCAT('b', n), CONCAT('c', n % 13), n * 3, IF(n % 100 = 0, REPEAT(CONCAT('lob', n), 3000), NULL) FROM s;
CREATE TABLE src.z16 (id INT PRIMARY KEY, a INT, b VARCHAR(40), c VARCHAR(40), d INT, blb BLOB,
KEY ka (a), KEY kb (b), KEY kc (c, d)) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=16;
INSERT INTO src.z16 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 3000)
SELECT n, n % 97, CONCAT('b', n), CONCAT('c', n % 13), n * 3, IF(n % 100 = 0, REPEAT(CONCAT('lob', n), 3000), NULL) FROM s;
# A 1 KB table with only a primary key: its map fits in page 0.
CREATE TABLE src.z1_small (id INT PRIMARY KEY, v VARCHAR(20)) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=1;
INSERT INTO src.z1_small WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 2000) SELECT n, CONCAT('v', n) FROM s;
CHECKSUM TABLE src.z1, src.z2, src.z4, src.z8, src.z16, src.z1_small;
Table	Checksum
src.z1	574550257
src.z2	574550257
src.z4	574550257
src.z8	574550257
src.z16	574550257
src.z1_small	3657261927
# kill -9 while the overflow pages are written (on the temporary file,
# without redo): nothing survives, and the statement can be re-run.
SET SESSION debug = '+d,wt_crash_in_overflow';
CREATE WORKTREE wt FROM src;
ERROR HY000: Lost connection to MySQL server during query
# restart
SET SESSION cte_max_recursion_depth = 100000;
SHOW DATABASES LIKE 'wt';
Database (wt)
SELECT COUNT(*) FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE 'wt/%';
COUNT(*)
0
CHECK TABLE src.z1;
Table	Op	Msg_type	Msg_text
src.z1	check	status	OK
CREATE WORKTREE wt FROM src;
