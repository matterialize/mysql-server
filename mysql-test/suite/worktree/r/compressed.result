Table	Checksum
wt.z1	574550257
wt.z2	574550257
wt.z4	574550257
wt.z8	574550257
wt.z16	574550257
wt.z1_small	3657261927
CHECK TABLE wt.z1, wt.z2, wt.z4, wt.z8, wt.z16, wt.z1_small;
Table	Op	Msg_type	Msg_text
wt.z1	check	status	OK
wt.z2	check	status	OK
wt.z4	check	status	OK
wt.z8	check	status	OK
wt.z16	check	status	OK
wt.z1_small	check	status	OK
SELECT COUNT(*), SUM(a), SUM(LENGTH(blb)) FROM wt.z1 FORCE INDEX (kc) WHERE c > 'c1';
COUNT(*)	SUM(a)	SUM(LENGTH(blb))
2539	121766	501000
# On disk, right after the clone: no data page was rewritten. Only page 0,
# page 1, the SDI and the allocator pages it touched, and overflow pages
# differ from the source.
SET GLOBAL innodb_fast_shutdown = 0;
z1: 5120 pages, data pages rewritten: 0, map in page 0: overflow
z2: 1024 pages, data pages rewritten: 0, map in page 0: inline
z4: 768 pages, data pages rewritten: 0, map in page 0: inline
z8: 640 pages, data pages rewritten: 0, map in page 0: inline
z16: 576 pages, data pages rewritten: 0, map in page 0: inline
z1_small: 5120 pages, data pages rewritten: 0, map in page 0: inline, or overflow in overlay mode
# restart
# After a restart the map (inline or from overflow pages) is read before
# any page: untouched pages of every index still read correctly.
SET SESSION cte_max_recursion_depth = 100000;
CHECKSUM TABLE wt.z1, wt.z2, wt.z4, wt.z8, wt.z16, wt.z1_small;
Table	Checksum
wt.z1	574550257
wt.z2	574550257
wt.z4	574550257
wt.z8	574550257
wt.z16	574550257
wt.z1_small	3657261927
CHECK TABLE wt.z1, wt.z2, wt.z4, wt.z8, wt.z16, wt.z1_small;
Table	Op	Msg_type	Msg_text
wt.z1	check	status	OK
wt.z2	check	status	OK
wt.z4	check	status	OK
wt.z8	check	status	OK
wt.z16	check	status	OK
wt.z1_small	check	status	OK
SELECT COUNT(*) FROM wt.z1 FORCE INDEX (kb) WHERE b LIKE 'b2%';
COUNT(*)
1111
# The worktree grows by many extents and the source changes too; neither
# allocation reaches the overflow pages or the other side.
INSERT INTO wt.z1 WITH RECURSIVE s(n) AS (SELECT 100001 UNION ALL SELECT n + 1 FROM s WHERE n < 120000)
SELECT n, n % 97, CONCAT('wb', n), CONCAT('wc', n % 13), n, REPEAT('w', 500) FROM s;
UPDATE wt.z8 SET b = CONCAT('wt-', b) WHERE id % 3 = 0;
DELETE FROM wt.z2 WHERE id % 2 = 0;
UPDATE src.z1 SET b = CONCAT('src-', b) WHERE id <= 500;
INSERT INTO src.z16 VALUES (5000, 1, 'src-only', 'c', 1, NULL);
SET GLOBAL innodb_fast_shutdown = 0;
# restart
CHECK TABLE src.z1, src.z2, src.z8, src.z16, wt.z1, wt.z2, wt.z8, wt.z16;
