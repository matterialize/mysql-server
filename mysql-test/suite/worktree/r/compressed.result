wt.z1	check	status	OK
wr1.z1	check	status	OK
wr3.z1	check	status	OK
DROP DATABASE wr1;
DROP DATABASE wr2;
DROP DATABASE wr3;
# DDL on the worktree rebuilds its own files only.
OPTIMIZE TABLE wt.z8;
Table	Op	Msg_type	Msg_text
wt.z8	optimize	note	Table does not support optimize, doing recreate + analyze instead
wt.z8	optimize	status	OK
ALTER TABLE wt.z4 ADD COLUMN e INT, ALGORITHM=COPY;
ALTER TABLE wt.z16 KEY_BLOCK_SIZE=4;
