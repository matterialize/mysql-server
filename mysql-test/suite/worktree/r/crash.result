# Crash at wt_crash_before_commit
SET SESSION debug = '+d,wt_crash_before_commit';
CREATE WORKTREE wt FROM src;
ERROR HY000: Lost connection to MySQL server during query
# restart
SHOW DATABASES LIKE 'wt';
Database (wt)
# no schema directory, no clone files
SELECT COUNT(*) FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE 'wt/%';
COUNT(*)
0
# Crash right after the commit: the worktree is complete.
SET SESSION debug = '+d,wt_crash_after_commit';
CREATE WORKTREE wt FROM src;
ERROR HY000: Lost connection to MySQL server during query
# restart
SHOW TABLES FROM wt;
Tables_in_wt
a
b
SELECT id, v, LENGTH(b) FROM wt.a ORDER BY id;
id	v	LENGTH(b)
1	one	40000
2	two	NULL
SELECT * FROM wt.b;
id	aid
1	1
CHECK TABLE wt.a, wt.b;
Table	Op	Msg_type	Msg_text
wt.a	check	status	OK
wt.b	check	status	OK
DROP DATABASE wt;
# After all that, a normal clone works.
CREATE WORKTREE wt FROM src;
SELECT id, v, LENGTH(b) FROM wt.a ORDER BY id;
id	v	LENGTH(b)
1	one	40000
2	two	NULL
DROP DATABASE wt;
DROP DATABASE src;
