# kill -9 at every phase of CREATE WORKTREE (fork-design.md §12.2):
# before the commit nothing survives and the statement can be re-run;
# after it the worktree is complete.
CREATE DATABASE src;
CREATE TABLE src.a (id INT PRIMARY KEY, v VARCHAR(20), b LONGBLOB);
CREATE TABLE src.b (id INT PRIMARY KEY, aid INT, FOREIGN KEY (aid) REFERENCES src.a(id));
INSERT INTO src.a VALUES (1, 'one', REPEAT('1', 40000)), (2, 'two', NULL);
INSERT INTO src.b VALUES (1, 1);
CREATE TABLE src.p (id INT, d DATE, PRIMARY KEY (id, d)) PARTITION BY RANGE (YEAR(d))
SUBPARTITION BY HASH (id) SUBPARTITIONS 2 (PARTITION p0 VALUES LESS THAN (2021), PARTITION p1 VALUES LESS THAN MAXVALUE);
INSERT INTO src.p VALUES (1, '2020-01-01'), (2, '2022-02-02');
CREATE TABLE src.f (id INT PRIMARY KEY, body TEXT, FULLTEXT (body));
INSERT INTO src.f VALUES (1, 'crash test document'), (2, 'another document');
CREATE VIEW src.v AS SELECT a.id, b.aid FROM src.a JOIN src.b ON b.aid = a.id;
CREATE FUNCTION src.fn() RETURNS INT READS SQL DATA RETURN (SELECT COUNT(*) FROM src.a);
CREATE TRIGGER src.trg AFTER INSERT ON src.b FOR EACH ROW UPDATE src.a SET v = CONCAT(v, '+') WHERE id = NEW.aid;
CREATE EVENT src.ev ON SCHEDULE EVERY 1 DAY DISABLE DO DELETE FROM src.b;
# kill -9 at every crash point before the commit (the points differ by
# mode: overlay mode has no reflink probe and freezes the writable source).
# Each one must leave no schema, directory, InnoDB table or object behind.
crash points that left nothing behind: at least 7: 1
# Crash right after the commit: the worktree is complete.
SET SESSION debug = '+d,wt_crash_after_commit';
CREATE WORKTREE wt FROM src;
ERROR HY000: Lost connection to MySQL server during query
# restart
SHOW FULL TABLES FROM wt;
Tables_in_wt	Table_type
a	BASE TABLE
b	BASE TABLE
f	BASE TABLE
p	BASE TABLE
v	VIEW
SELECT id, v, LENGTH(b) FROM wt.a ORDER BY id;
id	v	LENGTH(b)
1	one	40000
2	two	NULL
SELECT * FROM wt.b;
id	aid
1	1
SELECT * FROM wt.p ORDER BY id;
id	d
1	2020-01-01
2	2022-02-02
SELECT id FROM wt.f WHERE MATCH (body) AGAINST ('crash');
id
1
SELECT COUNT(*) AS fts_aux FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE 'wt/fts\_%';
fts_aux
11
SELECT wt.fn();
wt.fn()
2
SELECT ROUTINE_NAME FROM INFORMATION_SCHEMA.ROUTINES WHERE ROUTINE_SCHEMA = 'wt';
ROUTINE_NAME
fn
SELECT TRIGGER_NAME, ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA = 'wt';
TRIGGER_NAME	ACTION_STATEMENT
trg	UPDATE wt.a SET v = CONCAT(v, '+') WHERE id = NEW.aid
SELECT EVENT_NAME, STATUS FROM INFORMATION_SCHEMA.EVENTS WHERE EVENT_SCHEMA = 'wt';
EVENT_NAME	STATUS
ev	DISABLED
INSERT INTO wt.b VALUES (2, 2);
SELECT * FROM wt.v ORDER BY id, aid;
id	aid
1	1
2	2
CHECK TABLE wt.a, wt.b, wt.p, wt.f;
Table	Op	Msg_type	Msg_text
wt.a	check	status	OK
wt.b	check	status	OK
wt.p	check	status	OK
wt.f	check	status	OK
DROP DATABASE wt;
# After all that, a normal clone works.
CREATE WORKTREE wt FROM src;
SELECT id, v, LENGTH(b) FROM wt.a ORDER BY id;
id	v	LENGTH(b)
1	one	40000
2	two	NULL
DROP DATABASE wt;
DROP DATABASE src;
