# CREATE WORKTREE needs CREATE on the new schema and full SELECT on
# every table of the source (a clone exposes every column).
CREATE DATABASE src;
CREATE TABLE src.a (id INT PRIMARY KEY, secret INT);
CREATE TABLE src.b (id INT PRIMARY KEY);
CREATE USER u_db, u_tbl, u_col, u_nocreate;
GRANT SELECT ON src.* TO u_db;
GRANT CREATE ON `wt%`.* TO u_db, u_tbl, u_col;
GRANT SELECT ON src.a TO u_tbl;
GRANT SELECT ON src.b TO u_col;
GRANT SELECT (id) ON src.a TO u_col;
GRANT SELECT ON src.* TO u_nocreate;
CREATE WORKTREE wt1 FROM src;
ERROR 42000: Access denied for user 'u_nocreate'@'%' to database 'wt1'
CREATE WORKTREE wt2 FROM src;
Got one of the listed errors
CREATE WORKTREE wt3 FROM src;
Got one of the listed errors
SHOW DATABASES LIKE 'wt%';
Database (wt%)
CREATE WORKTREE wt4 FROM src;
SHOW TABLES FROM wt4;
Tables_in_wt4
a
b
DROP DATABASE wt4;
# Objects need the matching privilege on the source and the worktree,
# and cloning an object defined by someone else needs SET_ANY_DEFINER.
CREATE DATABASE src2;
CREATE TABLE src2.t (id INT PRIMARY KEY);
CREATE VIEW src2.v AS SELECT id FROM src2.t;
CREATE EVENT src2.e ON SCHEDULE EVERY 1 DAY DISABLE DO DELETE FROM src2.t;
CREATE TRIGGER src2.tr BEFORE INSERT ON src2.t FOR EACH ROW SET NEW.id = NEW.id;
GRANT SELECT ON src2.* TO u_db;
CREATE WORKTREE wt5 FROM src2;
ERROR 42000: Access denied for user 'u_db'@'%' to database 'src2'
GRANT EVENT ON src2.* TO u_db;
GRANT EVENT ON `wt%`.* TO u_db;
CREATE WORKTREE wt5 FROM src2;
ERROR 42000: Access denied for user 'u_db'@'%' to database 'wt5'
GRANT CREATE VIEW ON `wt%`.* TO u_db;
GRANT SHOW VIEW ON src2.* TO u_db;
CREATE WORKTREE wt5 FROM src2;
ERROR 42000: Access denied; you need (at least one of) the SET_ANY_DEFINER privilege(s) for this operation
GRANT SET_ANY_DEFINER ON *.* TO u_db;
CREATE WORKTREE wt5 FROM src2;
ERROR 42000: Access denied for user 'u_db'@'%' to database 'wt5'
GRANT TRIGGER ON src2.* TO u_db;
GRANT TRIGGER ON `wt%`.* TO u_db;
CREATE WORKTREE wt5 FROM src2;
SHOW FULL TABLES FROM wt5;
Tables_in_wt5	Table_type
t	BASE TABLE
v	VIEW
SELECT EVENT_NAME, STATUS FROM INFORMATION_SCHEMA.EVENTS WHERE EVENT_SCHEMA = 'wt5';
EVENT_NAME	STATUS
e	DISABLED
SELECT TRIGGER_NAME FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA = 'wt5';
TRIGGER_NAME
tr
DROP DATABASE wt5;
DROP DATABASE src2;
DROP USER u_db, u_tbl, u_col, u_nocreate;
DROP DATABASE src;
