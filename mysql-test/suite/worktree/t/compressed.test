--echo # ROW_FORMAT=COMPRESSED (fork-design.md §10.4): clones keep sharing every
--echo # data page. Pages are translated after their checksum is validated, in
--echo # both copies (compressed and uncompressed frame). At KEY_BLOCK_SIZE=1
--echo # page 0 has room for about one index, so larger maps go to overflow
--echo # pages taken from the file's own allocator.
--source include/have_debug.inc
--source include/not_valgrind.inc
--source include/have_innodb_16k.inc

let $datadir = `SELECT @@datadir`;
let WT_DD = $datadir;
SET SESSION cte_max_recursion_depth = 100000;

CREATE DATABASE src;
--echo # One table per KEY_BLOCK_SIZE, several indexes and BLOBs each.
let $kbs = 1;
while ($kbs <= 16)
{
  eval CREATE TABLE src.z$kbs (id INT PRIMARY KEY, a INT, b VARCHAR(40), c VARCHAR(40), d INT, blb BLOB,
    KEY ka (a), KEY kb (b), KEY kc (c, d)) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=$kbs;
  eval INSERT INTO src.z$kbs WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 3000)
    SELECT n, n % 97, CONCAT('b', n), CONCAT('c', n % 13), n * 3, IF(n % 100 = 0, REPEAT(CONCAT('lob', n), 3000), NULL) FROM s;
  let $kbs = `SELECT $kbs * 2`;
}
--echo # A 1 KB table with only a primary key: its map fits in page 0.
CREATE TABLE src.z1_small (id INT PRIMARY KEY, v VARCHAR(20)) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=1;
INSERT INTO src.z1_small WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 2000) SELECT n, CONCAT('v', n) FROM s;

CHECKSUM TABLE src.z1, src.z2, src.z4, src.z8, src.z16, src.z1_small;

CREATE WORKTREE wt FROM src;
CHECKSUM TABLE wt.z1, wt.z2, wt.z4, wt.z8, wt.z16, wt.z1_small;
CHECK TABLE wt.z1, wt.z2, wt.z4, wt.z8, wt.z16, wt.z1_small;
SELECT COUNT(*), SUM(a), SUM(LENGTH(blb)) FROM wt.z1 FORCE INDEX (kc) WHERE c > 'c1';

--echo # On disk, right after the clone: no data page was rewritten. Only page 0,
--echo # page 1, the SDI and the allocator pages it touched, and overflow pages
--echo # differ from the source.
SET GLOBAL innodb_fast_shutdown = 0;
--source include/shutdown_mysqld.inc
perl;
  my $dd = $ENV{WT_DD};
  for my $t (qw(z1 z2 z4 z8 z16 z1_small)) {
    my $ps = $t eq 'z1_small' ? 1024 : ($t =~ /(\d+)/)[0] * 1024;
    open(my $a, "<:raw", "$dd/src/$t.ibd") or die "$dd/src/$t.ibd: $!"; open(my $b, "<:raw", "$dd/wt/$t.ibd") or die "$dd/wt/$t.ibd: $!";
    my ($pa, $pb, $n, %diff) = ('', '', 0);
    while (sysread($b, $pb, $ps) == $ps) {
      my $got = sysread($a, $pa, $ps);
      my $type = unpack('n', substr($pb, 24, 2));
      $diff{$type}++ if !$got || $pa ne $pb;
      $n++;
    }
    # FIL_PAGE_INDEX 17855, compressed BLOB pages 11/12, compressed LOB 22-26
    my $data = 0; $data += $diff{$_} // 0 for (17855, 11, 12, 22, 23, 24, 25, 26);
    # Page 0 tail: an inline map ("WTM1") or an overflow stub ("WTO1").
    sysseek($b, 0, 0); sysread($b, $pb, $ps);
    my $kind = $pb =~ /WTM1/ ? 'inline' : $pb =~ /WTO1/ ? 'overflow' : 'none';
    printf("%s: %d pages, data pages rewritten: %d, map in page 0: %s\n", $t, $n, $data, $kind);
  }
EOF
--source include/start_mysqld.inc

--echo # After a restart the map (inline or from overflow pages) is read before
--echo # any page: untouched pages of every index still read correctly.
SET SESSION cte_max_recursion_depth = 100000;
CHECKSUM TABLE wt.z1, wt.z2, wt.z4, wt.z8, wt.z16, wt.z1_small;
CHECK TABLE wt.z1, wt.z2, wt.z4, wt.z8, wt.z16, wt.z1_small;
SELECT COUNT(*) FROM wt.z1 FORCE INDEX (kb) WHERE b LIKE 'b2%';

--echo # The worktree grows by many extents and the source changes too; neither
--echo # allocation reaches the overflow pages or the other side.
INSERT INTO wt.z1 WITH RECURSIVE s(n) AS (SELECT 100001 UNION ALL SELECT n + 1 FROM s WHERE n < 120000)
  SELECT n, n % 97, CONCAT('wb', n), CONCAT('wc', n % 13), n, REPEAT('w', 500) FROM s;
UPDATE wt.z8 SET b = CONCAT('wt-', b) WHERE id % 3 = 0;
DELETE FROM wt.z2 WHERE id % 2 = 0;
UPDATE src.z1 SET b = CONCAT('src-', b) WHERE id <= 500;
INSERT INTO src.z16 VALUES (5000, 1, 'src-only', 'c', 1, NULL);
SET GLOBAL innodb_fast_shutdown = 0;
--source include/restart_mysqld.inc
CHECK TABLE src.z1, src.z2, src.z8, src.z16, wt.z1, wt.z2, wt.z8, wt.z16;
SELECT COUNT(*), SUM(b LIKE 'src-%') FROM src.z1;
SELECT COUNT(*), SUM(b LIKE 'src-%'), SUM(b LIKE 'wb%') FROM wt.z1;
SELECT COUNT(*) FROM src.z2;
SELECT COUNT(*) FROM wt.z2;
SELECT SUM(b LIKE 'wt-%') FROM src.z8;
SELECT SUM(b LIKE 'wt-%') FROM wt.z8;
SELECT COUNT(*) FROM wt.z16 WHERE b = 'src-only';
--echo # Every page on disk, shared or not, still has a valid checksum.
--source include/shutdown_mysqld.inc
--exec $INNOCHECKSUM $WT_DD/wt/z1.ibd
--exec $INNOCHECKSUM $WT_DD/wt/z1_small.ibd
--exec $INNOCHECKSUM $WT_DD/wt/z16.ibd
--source include/start_mysqld.inc

--echo # A worktree of the worktree: a longer chain, still overflow at 1 KB.
CREATE WORKTREE wt2 FROM wt;
CHECKSUM TABLE wt.z1, wt.z1_small, wt.z4;
CHECKSUM TABLE wt2.z1, wt2.z1_small, wt2.z4;
perl;
  my $dd = $ENV{WT_DD};
  for my $t (qw(z1 z1_small)) {
    open(my $b, '<:raw', "$dd/wt2/$t.ibd") or die "$t: $!"; my $p; sysread($b, $p, 1024);
    my $anc = $p =~ /WTM1/ ? 'inline' : $p =~ /WTO1/ ? 'overflow' : 'none';
    print "wt2.$t: map in page 0: $anc\n";
  }
EOF
--source include/restart_mysqld.inc
CHECK TABLE wt2.z1, wt2.z2, wt2.z4, wt2.z8, wt2.z16, wt2.z1_small;
SELECT COUNT(*), SUM(b LIKE 'wb%') FROM wt2.z1 FORCE INDEX (kb);

--echo # DDL on the worktree rebuilds its own files only.
OPTIMIZE TABLE wt.z8;
ALTER TABLE wt.z4 ADD COLUMN e INT, ALGORITHM=COPY;
ALTER TABLE wt.z16 KEY_BLOCK_SIZE=4;
CHECKSUM TABLE src.z8, src.z4, src.z16;
CHECK TABLE src.z8, src.z4, src.z16, wt.z8, wt.z4, wt.z16, wt2.z8, wt2.z4, wt2.z16;

DROP DATABASE wt2;
DROP DATABASE wt;
DROP DATABASE src;
