--echo # INSTANT ADD/DROP COLUMN row versions survive the clone: rows written
--echo # under each version still parse.

CREATE DATABASE src;
CREATE TABLE src.t (id INT PRIMARY KEY, a INT, b VARCHAR(10));
INSERT INTO src.t VALUES (1, 10, 'v0');
ALTER TABLE src.t ADD COLUMN c INT DEFAULT 7, ALGORITHM=INSTANT;
INSERT INTO src.t VALUES (2, 20, 'v1', 2);
ALTER TABLE src.t DROP COLUMN a, ALGORITHM=INSTANT;
INSERT INTO src.t VALUES (3, 'v2', 3);
ALTER TABLE src.t ADD COLUMN d VARCHAR(10) DEFAULT 'dd' FIRST, ALGORITHM=INSTANT;
INSERT INTO src.t VALUES ('x', 4, 'v3', 4);
SELECT NAME, TOTAL_ROW_VERSIONS FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME = 'src/t';

CREATE WORKTREE wt FROM src;
SELECT NAME, TOTAL_ROW_VERSIONS FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME = 'wt/t';
SELECT * FROM src.t ORDER BY id;
SELECT * FROM wt.t ORDER BY id;

--echo # Keep evolving the worktree only.
ALTER TABLE wt.t ADD COLUMN e INT DEFAULT 99, ALGORITHM=INSTANT;
UPDATE wt.t SET b = CONCAT(b, '+') WHERE id IN (1, 3);
INSERT INTO wt.t VALUES ('y', 5, 'v4', 5, 55);
ALTER TABLE wt.t DROP COLUMN c, ALGORITHM=INSTANT;
SELECT * FROM wt.t ORDER BY id;
SELECT * FROM src.t ORDER BY id;
CHECK TABLE src.t, wt.t;

--source include/restart_mysqld.inc
SELECT * FROM wt.t ORDER BY id;
SELECT * FROM src.t ORDER BY id;

DROP DATABASE wt;
DROP DATABASE src;
