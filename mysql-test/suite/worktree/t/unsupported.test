--echo # Cases outside the reflink core are refused with a clear error and
--echo # leave nothing behind.
--source include/have_debug.inc

CREATE DATABASE src;
CREATE TABLE src.ok (id INT PRIMARY KEY);
let $datadir= `SELECT @@datadir`;

CREATE TABLE src.f (id INT PRIMARY KEY, txt TEXT, FULLTEXT(txt));
--error ER_NOT_SUPPORTED_YET
CREATE WORKTREE wt FROM src;
DROP TABLE src.f;

CREATE TABLE src.z (id INT PRIMARY KEY) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=8;
--error ER_NOT_SUPPORTED_YET
CREATE WORKTREE wt FROM src;
DROP TABLE src.z;

CREATE TABLE src.m (id INT PRIMARY KEY) ENGINE=MyISAM;
--error ER_NOT_SUPPORTED_YET
CREATE WORKTREE wt FROM src;
DROP TABLE src.m;

CREATE TABLE src.pt (id INT PRIMARY KEY) PARTITION BY HASH(id) PARTITIONS 2;
--error ER_NOT_SUPPORTED_YET
CREATE WORKTREE wt FROM src;
DROP TABLE src.pt;

CREATE TABLESPACE ts1 ADD DATAFILE 'ts1.ibd';
CREATE TABLE src.g (id INT PRIMARY KEY) TABLESPACE ts1;
--error ER_NOT_SUPPORTED_YET
CREATE WORKTREE wt FROM src;
DROP TABLE src.g;
DROP TABLESPACE ts1;

CREATE TABLE src.s (id INT PRIMARY KEY) TABLESPACE innodb_system;
--error ER_NOT_SUPPORTED_YET
CREATE WORKTREE wt FROM src;
DROP TABLE src.s;

CREATE VIEW src.v AS SELECT * FROM src.ok;
--error ER_NOT_SUPPORTED_YET
CREATE WORKTREE wt FROM src;
DROP VIEW src.v;

CREATE PROCEDURE src.pr() SELECT 1;
--error ER_NOT_SUPPORTED_YET
CREATE WORKTREE wt FROM src;
DROP PROCEDURE src.pr;

CREATE TRIGGER src.tr BEFORE INSERT ON src.ok FOR EACH ROW SET NEW.id = NEW.id;
--error ER_NOT_SUPPORTED_YET
CREATE WORKTREE wt FROM src;
DROP TRIGGER src.tr;

CREATE EVENT src.ev ON SCHEDULE EVERY 1 DAY DISABLE DO SELECT 1;
--error ER_NOT_SUPPORTED_YET
CREATE WORKTREE wt FROM src;
DROP EVENT src.ev;

--echo # Nothing was left behind by the refusals.
SHOW DATABASES LIKE 'wt';
--error 1
--file_exists $datadir/wt

--echo # An error after files were cloned rolls everything back.
CREATE TABLE src.ok2 (id INT PRIMARY KEY);
SET SESSION debug = '+d,wt_fail_after_page0';
--error ER_UNKNOWN_ERROR
CREATE WORKTREE wt FROM src;
SET SESSION debug = '-d,wt_fail_after_page0';
SHOW DATABASES LIKE 'wt';
--error 1
--file_exists $datadir/wt

CREATE WORKTREE wt FROM src;
SHOW TABLES FROM wt;
DROP DATABASE wt;
DROP DATABASE src;
