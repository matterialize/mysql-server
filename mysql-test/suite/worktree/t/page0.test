--echo # Page 0 is no longer a single point of failure (fork-design.md §12.1 H5,
--echo # §10.1 item 4): the ancestor map has a copy in page 1 that names the
--echo # file's own space id, and startup never identifies a worktree file as
--echo # its ancestor.
--source include/have_debug.inc
--source include/not_valgrind.inc
--source include/have_innodb_16k.inc

let $datadir = `SELECT @@datadir`;
# Hand-started servers get the running one's settings (the combination's
# options are on its command line, not in my.cnf).
let $wt_opts = `SELECT CONCAT('--innodb-worktree-mode=', @@innodb_worktree_mode, ' --innodb-thread-concurrency=', @@innodb_thread_concurrency, ' --innodb-redo-log-capacity=', @@innodb_redo_log_capacity)`;
let WT_IBD = $datadir/wt/big.ibd;
let SRC_IBD = $datadir/src/big.ibd;
let $error_log = $MYSQLTEST_VARDIR/log/mysqld.1.err;

call mtr.add_suppression("Worktree map in page 0 of tablespace wt/big is damaged");
call mtr.add_suppression("Header page consists of zero bytes in datafile: ./(wt|src)/big.ibd");

SET SESSION cte_max_recursion_depth = 100000;
CREATE DATABASE src;
CREATE TABLE src.big (id INT PRIMARY KEY, pad CHAR(200));
INSERT INTO src.big WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 900) SELECT n, 'x' FROM s;

--echo #
--echo # A. The map in page 0 is garbled (page checksum re-stamped, so only the
--echo #    map's own CRC catches it): the copy in page 1 is used.
CREATE WORKTREE wt FROM src;
UPDATE wt.big SET pad = 'wt' WHERE id = 1;
SET GLOBAL innodb_fast_shutdown = 0;
--source include/shutdown_mysqld.inc
perl;
  my $f = $ENV{WT_IBD}; open(my $fh, '+<:raw', $f) or die "$f: $!"; my $p;
  sysseek($fh, 0, 0); sysread($fh, $p, 16384);
  my $off = 16384 - 8 - 4096;
  for my $i (40 .. 71) { substr($p, $off + $i, 1) = chr(ord(substr($p, $off + $i, 1)) ^ 0x5A); }
  sysseek($fh, 0, 0); syswrite($fh, $p); close($fh);
EOF
--exec $INNOCHECKSUM --no-check --page=0 --write=crc32 $WT_IBD > /dev/null 2>&1
--exec $INNOCHECKSUM --page=0 $WT_IBD
--source include/start_mysqld.inc
SELECT COUNT(*), SUM(id), MAX(pad) FROM wt.big;
SELECT COUNT(*), MAX(pad) FROM src.big;
CHECK TABLE wt.big;
let SEARCH_FILE = $error_log;
--let SEARCH_PATTERN = Worktree map in page 0 of tablespace wt/big is damaged; using the copy in page 1
--source include/search_pattern.inc
DROP DATABASE wt;

--echo #
--echo # B. Page 0 is lost (zeroed) after a crash: startup identifies the file by
--echo #    the copy in page 1 and restores the worktree's own page 0 from the
--echo #    doublewrite buffer.
CREATE WORKTREE wt FROM src;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO wt.big WITH RECURSIVE s(n) AS (SELECT 1000 UNION ALL SELECT n + 1 FROM s WHERE n < 9000) SELECT n, 'y' FROM s;
# Flush page 0 (now changed by the file extension) through the doublewrite
# buffer, then keep the next change in redo only, so recovery opens the file.
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE wt.big SET pad = 'after-checkpoint' WHERE id = 5;
--source include/kill_mysqld.inc
perl;
  my $f = $ENV{WT_IBD}; open(my $fh, '+<:raw', $f) or die "$f: $!";
  sysseek($fh, 0, 0); syswrite($fh, "\0" x 16384); close($fh);
EOF
--let $restart_parameters = restart: --log-error-verbosity=3
--source include/start_mysqld.inc
SELECT COUNT(*), MAX(id) FROM wt.big;
SELECT pad FROM wt.big WHERE id = 5;
SELECT COUNT(*) FROM src.big;
CHECK TABLE wt.big, src.big;
--let SEARCH_PATTERN = Datafile './wt/big.ibd' is a worktree; its own space id [0-9]+ is taken from page 1
--source include/search_pattern.inc
--let SEARCH_PATTERN = Restoring page \[page id: space=[0-9]+, page number=0\] of datafile './wt/big.ibd' from the doublewrite buffer
--source include/search_pattern.inc
perl;
  sub space_id { my $f = shift; open(my $fh, '<:raw', $f) or die; my $p; sysread($fh, $p, 16384); return unpack('N', substr($p, 34, 4)); }
  print "page 0 of the worktree is its own: ", (space_id($ENV{WT_IBD}) != space_id($ENV{SRC_IBD}) ? "yes" : "NO"), "\n";
EOF
DROP DATABASE wt;

--echo #
--echo # C. Pages 0 and 1 are both lost and nearly every page still carries the
--echo #    ancestor's id, with the ancestor's page 0 in the doublewrite buffer.
--echo #    A plain majority vote would pick the ancestor and restore its page 0
--echo #    into the worktree's file; instead the vote refuses the ancestor and
--echo #    startup stops with the file unidentified.
CREATE WORKTREE wt FROM src;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO src.big WITH RECURSIVE s(n) AS (SELECT 1000 UNION ALL SELECT n + 1 FROM s WHERE n < 9000) SELECT n, 'y' FROM s;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE wt.big SET pad = 'after-checkpoint' WHERE id = 5;
--source include/kill_mysqld.inc
--copy_file $WT_IBD $MYSQLTEST_VARDIR/tmp/wt_big.ibd.saved
perl;
  my $f = $ENV{WT_IBD}; open(my $fh, '+<:raw', $f) or die "$f: $!";
  sysseek($fh, 0, 0); syswrite($fh, "\0" x 32768); close($fh);
EOF
let $c_log = $MYSQLTEST_VARDIR/log/page0_case_c.err;
# Reflink mode: the vote refuses the ancestor and no file is identified
# (exit 1). Overlay mode: the worktree's holes don't vote, its own written
# pages identify it, and its page 0 has no doublewrite copy (fatal, exit 2).
--error 1,2
--exec $MYSQLD_CMD $wt_opts --log-error=$c_log --log-error-verbosity=3 > /dev/null 2>&1
let SEARCH_FILE = $c_log;
# Either guard may refuse the ancestor first: "belongs to another file" needs
# the source's file scanned already, and the startup scan runs in parallel;
# the ancestor registry does not depend on the order.
--let SEARCH_PATTERN = (Datafile './wt/big.ibd': space id [0-9]+ (belongs to another file|is a worktree ancestor and this is not its file); not chosen|Header page consists of zero bytes in datafile: ./wt/big.ibd)
--source include/search_pattern.inc
--let SEARCH_PATTERN = (Could not find any file associated with the tablespace ID|could not be found in the doublewrite buffer)
--source include/search_pattern.inc
perl;
  sub space_id { my $f = shift; open(my $fh, '<:raw', $f) or die; my $p; sysread($fh, $p, 16384); return unpack('N', substr($p, 34, 4)); }
  print "source page 0 written into the worktree: ", (space_id($ENV{WT_IBD}) == space_id($ENV{SRC_IBD}) ? "YES" : "no"), "\n";
EOF
--echo # Put the file back; recovery then completes normally.
--remove_file $WT_IBD
--copy_file $MYSQLTEST_VARDIR/tmp/wt_big.ibd.saved $WT_IBD
--remove_file $MYSQLTEST_VARDIR/tmp/wt_big.ibd.saved
--remove_file $c_log
--let $restart_parameters = restart
--source include/start_mysqld.inc
SELECT pad FROM wt.big WHERE id = 5;
CHECK TABLE wt.big;

DROP DATABASE wt;

--echo #
--echo # D. Page 0 lost after a clean shutdown (nothing in the doublewrite
--echo #    buffer): unrecoverable, exactly as for a stock table. Stock InnoDB
--echo #    either reports such a tablespace missing or stops with "Tablespace id
--echo #    is N in the data dictionary but in file ... it is 0" on first access
--echo #    (also when the buffer pool dump is loaded), so the table is not
--echo #    touched here. What a worktree must add: the server starts, the source
--echo #    is unaffected, and the worktree's page 0 is never replaced.
CREATE WORKTREE wt FROM src;
SET GLOBAL innodb_fast_shutdown = 0;
--source include/shutdown_mysqld.inc
--copy_file $WT_IBD $MYSQLTEST_VARDIR/tmp/wt_big.ibd.saved
perl;
  my $f = $ENV{WT_IBD}; open(my $fh, '+<:raw', $f) or die "$f: $!";
  sysseek($fh, 0, 0); syswrite($fh, "\0" x 16384); close($fh);
EOF
--let $restart_parameters = restart: --innodb-buffer-pool-load-at-startup=OFF
--source include/start_mysqld.inc
SELECT COUNT(*) FROM src.big;
CHECK TABLE src.big;
perl;
  my $f = $ENV{WT_IBD}; open(my $fh, '<:raw', $f) or die; my $p; sysread($fh, $p, 16384);
  print "page 0 of the worktree is still all zero: ", ($p eq ("\0" x 16384) ? "yes" : "NO"), "\n";
EOF
--source include/shutdown_mysqld.inc
--remove_file $WT_IBD
--copy_file $MYSQLTEST_VARDIR/tmp/wt_big.ibd.saved $WT_IBD
--remove_file $MYSQLTEST_VARDIR/tmp/wt_big.ibd.saved
--let $restart_parameters = restart
--source include/start_mysqld.inc
SELECT COUNT(*) FROM wt.big;
DROP DATABASE wt;

--echo #
--echo # E. The source's own torn page 0 is still restored from the doublewrite
--echo #    buffer, as in stock: #wt_ancestors records ./src/big.ibd as the
--echo #    file of space 2's id, so the vote may pick it for that file.
CREATE WORKTREE wt FROM src;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO src.big WITH RECURSIVE s(n) AS (SELECT 20000 UNION ALL SELECT n + 1 FROM s WHERE n < 28000) SELECT n, 'z' FROM s;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE src.big SET pad = 'src-after-checkpoint' WHERE id = 5;
--source include/kill_mysqld.inc
perl;
  my $f = $ENV{SRC_IBD}; open(my $fh, '+<:raw', $f) or die "$f: $!";
  sysseek($fh, 0, 0); syswrite($fh, "\0" x 16384); close($fh);
EOF
--let $restart_parameters = restart: --log-error-verbosity=3
--source include/start_mysqld.inc
SELECT pad FROM src.big WHERE id = 5;
SELECT COUNT(*) FROM src.big;
CHECK TABLE src.big, wt.big;
let SEARCH_FILE = $error_log;
--let SEARCH_PATTERN = Restoring page \[page id: space=[0-9]+, page number=0\] of datafile './src/big.ibd' from the doublewrite buffer
--source include/search_pattern.inc

--echo #
--echo # F. As C, but the source is dropped first, so no other file claims its
--echo #    id: the vote still never picks the ancestor (#wt_ancestors), and the
--echo #    ancestor's page 0 is not written into the worktree.
INSERT INTO src.big VALUES (99999, 'last');
SET GLOBAL innodb_log_checkpoint_now = ON;
DROP DATABASE src;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE wt.big SET pad = 'wt-after-drop' WHERE id = 5;
--source include/kill_mysqld.inc
--copy_file $WT_IBD $MYSQLTEST_VARDIR/tmp/wt_big.ibd.saved
perl;
  my $f = $ENV{WT_IBD}; open(my $fh, '+<:raw', $f) or die "$f: $!";
  sysseek($fh, 0, 0); syswrite($fh, "\0" x 32768); close($fh);
EOF
let $f_log = $MYSQLTEST_VARDIR/log/page0_case_f.err;
# As in C: reflink mode exits 1, overlay mode (own id found, no page-0 copy)
# exits 2; neither writes the ancestor's page 0 into the worktree.
--error 1,2
--exec $MYSQLD_CMD $wt_opts --log-error=$f_log --log-error-verbosity=3 > /dev/null 2>&1
let SEARCH_FILE = $f_log;
--let SEARCH_PATTERN = (Datafile './wt/big.ibd': space id [0-9]+ is a worktree ancestor and this is not its file; not chosen|could not be found in the doublewrite buffer)
--source include/search_pattern.inc
perl;
  my $f = $ENV{WT_IBD}; open(my $fh, '<:raw', $f) or die; my $p; sysread($fh, $p, 32768);
  print "pages 0 and 1 of the worktree are still all zero: ", ($p eq ("\0" x 32768) ? "yes" : "NO"), "\n";
EOF
--remove_file $WT_IBD
--copy_file $MYSQLTEST_VARDIR/tmp/wt_big.ibd.saved $WT_IBD
--remove_file $MYSQLTEST_VARDIR/tmp/wt_big.ibd.saved
--remove_file $f_log
--let $restart_parameters = restart
--source include/start_mysqld.inc
SELECT pad FROM wt.big WHERE id = 5;
CHECK TABLE wt.big;

DROP DATABASE wt;

--echo #
--echo # G. A 1 KB compressed worktree's page 0 lost after a crash. Compressed
--echo #    page 1 has no map area (the change buffer writes past the bitmap's
--echo #    physical extent there, as stock does), so the file is identified by
--echo #    InnoDB's page vote. Whatever the vote makes of it (it may restore
--echo #    the worktree's own page 0, or stop with the file unidentified), it
--echo #    never restores the source's page 0 into the worktree.
call mtr.add_suppression("Header page consists of zero bytes in datafile: ./wz/zc.ibd");
# The background server may still hold the datadir lock briefly after it
# exits; the next start retries it.
call mtr.add_suppression("Unable to lock ./ibdata1 error: 11");
let WZ_IBD = $datadir/wz/zc.ibd;
let ZSRC_IBD = $datadir/src/zc.ibd;
CREATE DATABASE src;
CREATE TABLE src.zc (id INT PRIMARY KEY, v VARCHAR(40), KEY (v)) ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=1;
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO src.zc WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 3000) SELECT n, CONCAT('z', n) FROM s;
CREATE WORKTREE wz FROM src;
INSERT INTO wz.zc WITH RECURSIVE s(n) AS (SELECT 10001 UNION ALL SELECT n + 1 FROM s WHERE n < 16000) SELECT n, 'grown' FROM s;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE wz.zc SET v = 'after-checkpoint' WHERE id = 5;
--source include/kill_mysqld.inc
--copy_file $WZ_IBD $MYSQLTEST_VARDIR/tmp/wz_zc.ibd.saved
perl;
  my $f = $ENV{WZ_IBD}; open(my $fh, '+<:raw', $f) or die "$f: $!";
  sysseek($fh, 0, 0); syswrite($fh, "\0" x 1024); close($fh);
EOF
let G_LOG = $MYSQLTEST_VARDIR/log/page0_compressed.err;
--exec_in_background $MYSQLD_CMD $wt_opts --log-error=$G_LOG --log-error-verbosity=3
let MYSQLD_SOCK = $MASTER_MYSOCK;
perl;
  # Wait for startup to finish either way; stop the server if it came up.
  my ($log, $up) = ($ENV{G_LOG}, 0);
  for (1 .. 600) {
    my $t = -e $log ? do { local (@ARGV, $/) = $log; <> } : '';
    if ($t =~ /ready for connections/) { $up = 1; last; }
    last if $t =~ /Aborting|Shutdown complete/;
    select(undef, undef, undef, 0.2);
  }
  system("$ENV{MYSQLADMIN} -uroot -S $ENV{MYSQLD_SOCK} shutdown >/dev/null 2>&1") if $up;
  for (1 .. 300) { my $t = do { local (@ARGV, $/) = $log; <> }; last if $t =~ /MySQL Server - end/;
    select(undef, undef, undef, 0.2); }
  sleep(2);
  sub space_id1k { my $f = shift; open(my $fh, '<:raw', $f) or die; my $p; sysread($fh, $p, 1024); return unpack('N', substr($p, 34, 4)); }
  print "source page 0 written into the compressed worktree: ", (space_id1k($ENV{WZ_IBD}) == space_id1k($ENV{ZSRC_IBD}) ? "YES" : "no"), "\n";
  my $saved = "$ENV{MYSQLTEST_VARDIR}/tmp/wz_zc.ibd.saved";
  if (!$up) { require File::Copy; File::Copy::copy($saved, $ENV{WZ_IBD}) or die "restore: $!"; }
  unlink($saved) or die "$saved: $!";
EOF
--remove_file $G_LOG
--source include/start_mysqld.inc
SELECT COUNT(*), SUM(v = 'grown') FROM wz.zc;
CHECK TABLE wz.zc, src.zc;
DROP DATABASE wz;
DROP DATABASE src;
