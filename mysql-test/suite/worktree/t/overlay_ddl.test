--echo # DDL on overlays (limits/overlay-v3.md §5.3 rows 2-3, §6.4 "CREATE INDEX",
--echo # §11.14): a bulk-built index (no redo for its pages) on an overlay is read
--echo # before and after a restart; kill -9 before and after its DDL commit.
--echo # Debug asserts check that no page of the new index is ever read from the
--echo # layer (written ones are PRESENT, never a hole).
--source include/have_debug.inc
--source include/not_valgrind.inc
--source include/have_innodb_16k.inc
let $overlay = `SELECT @@innodb_worktree_mode = 'OVERLAY'`;
if (!$overlay)
{
  --skip Needs overlay mode (no reflink, or innodb_worktree_mode=OVERLAY)
}

SET SESSION cte_max_recursion_depth = 100000;
CREATE DATABASE src;
CREATE TABLE src.t (id INT PRIMARY KEY, a INT, v VARCHAR(100));
INSERT INTO src.t WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 20000)
  SELECT n, n % 97, CONCAT('row', n) FROM s;
CREATE WORKTREE wt FROM src;

--echo #
--echo # 1. CREATE INDEX on an overlay: read through the new index at once, and
--echo #    after a restart (its pages are fsynced locally before the commit).
UPDATE wt.t SET a = 1000 WHERE id <= 30;
ALTER TABLE wt.t ADD INDEX ka (a), ALGORITHM = INPLACE;
SELECT COUNT(*) FROM wt.t FORCE INDEX (ka) WHERE a = 1000;
SELECT COUNT(*) FROM wt.t FORCE INDEX (ka) WHERE a < 97;
--source include/restart_mysqld.inc
SELECT COUNT(*) FROM wt.t FORCE INDEX (ka) WHERE a = 1000;
CHECK TABLE wt.t;

--echo #
--echo # 2. kill -9 after the bulk build, before its DDL commit (the stock sync
--echo #    point after the in-place build), and right before and after the
--echo #    commit: the index is either absent or complete.
UPDATE wt.t SET v = 'd0' WHERE id % 50 = 0;
connect (con1, localhost, root,,);
SET DEBUG_SYNC = 'innodb_after_inplace_alter_table SIGNAL built WAIT_FOR never';
send ALTER TABLE wt.t ADD INDEX kv0 (v), ALGORITHM = INPLACE;
connection default;
SET DEBUG_SYNC = 'now WAIT_FOR built';
--source include/kill_mysqld.inc
--source include/start_mysqld.inc
disconnect con1;
SELECT COUNT(*) AS has_index FROM INFORMATION_SCHEMA.STATISTICS
  WHERE TABLE_SCHEMA = 'wt' AND TABLE_NAME = 't' AND INDEX_NAME = 'kv0';
SELECT COUNT(*), SUM(v = 'd0') FROM wt.t;
CHECK TABLE wt.t;
let $points = crash_commit_before crash_commit_after;
let $i = 0;
while ($points)
{
  let $point = `SELECT SUBSTRING_INDEX('$points', ' ', 1)`;
  let $points = `SELECT TRIM(SUBSTR('$points', LENGTH('$point') + 1))`;
  inc $i;
  eval UPDATE wt.t SET v = 'd$i' WHERE id % 50 = 0;
  --source include/expect_crash.inc
  eval SET SESSION debug = '+d,$point';
  --error CR_SERVER_LOST
  eval ALTER TABLE wt.t ADD INDEX kv$i (v), ALGORITHM = INPLACE;
  --source include/start_mysqld.inc
  eval SELECT '$point' AS point, COUNT(*) AS has_index FROM INFORMATION_SCHEMA.STATISTICS
       WHERE TABLE_SCHEMA = 'wt' AND TABLE_NAME = 't' AND INDEX_NAME = 'kv$i';
  eval SELECT COUNT(*), SUM(v = 'd$i') FROM wt.t;
  CHECK TABLE wt.t;
}

--echo #
--echo # 3. An in-place rebuild of an overlay (a new standalone file) and an
--echo #    instant ADD COLUMN on one.
CREATE WORKTREE wt2 FROM src;
UPDATE wt2.t SET v = 'rebuilt' WHERE id <= 10;
ALTER TABLE wt2.t ENGINE = InnoDB, ALGORITHM = INPLACE;
SELECT FLAG & 32768 AS overlay_bit FROM INFORMATION_SCHEMA.INNODB_TABLESPACES WHERE NAME = 'wt2/t';
ALTER TABLE wt.t ADD COLUMN c INT DEFAULT 7, ALGORITHM = INSTANT;
--source include/restart_mysqld.inc
SELECT COUNT(*), SUM(v = 'rebuilt') FROM wt2.t;
SELECT COUNT(*), SUM(c) FROM wt.t;
CHECK TABLE wt.t, wt2.t, src.t;

DROP DATABASE wt2;
DROP DATABASE wt;
DROP DATABASE src;
SHOW GLOBAL STATUS LIKE 'Innodb_worktree_layers';
