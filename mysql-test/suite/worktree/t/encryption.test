--echo # Encrypted tables (fork-design.md §10.4): the clone keeps the source's
--echo # tablespace key, copied with page 0 (never encrypted), and its pages
--echo # stay encrypted on disk. CREATE WORKTREE writes no .cfg or .cfp file,
--echo # which would hold the tablespace key in the clear. Master key rotation
--echo # re-encrypts the key in both files.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_valgrind.inc
--source include/have_innodb_16k.inc
--source include/have_component_keyring_file.inc
--source suite/component_keyring_file/inc/setup_component.inc
# Restarts keep the keyring's --plugin-dir; do not echo the host path.
let $do_not_echo_parameters = 1;

let $datadir = `SELECT @@datadir`;
let WT_DD = $datadir;
SET SESSION cte_max_recursion_depth = 100000;

CREATE DATABASE src DEFAULT ENCRYPTION = 'Y';
CREATE TABLE src.e (id INT PRIMARY KEY, v VARCHAR(100), w INT, KEY kv (v), KEY kw (w)) ENCRYPTION = 'Y';
INSERT INTO src.e WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 5000)
  SELECT n, CONCAT('plaintext-marker-', n), n % 7 FROM s;
--echo # Encrypted and compressed at 1 KB: the map is in overflow pages, which
--echo # are encrypted like any other page.
CREATE TABLE src.ez (id INT PRIMARY KEY, a INT, b VARCHAR(40), c INT, KEY ka (a), KEY kb (b), KEY kc (c))
  ROW_FORMAT = COMPRESSED KEY_BLOCK_SIZE = 1 ENCRYPTION = 'Y';
INSERT INTO src.ez WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 3000)
  SELECT n, n % 11, CONCAT('zmarker-', n), n * 2 FROM s;
CREATE TABLE src.p (id INT PRIMARY KEY, v VARCHAR(20)) ENCRYPTION = 'N';
INSERT INTO src.p VALUES (1, 'plain');

--echo # No .cfg or .cfp at any point, including while the source is quiesced.
connect (con1, localhost, root,,);
SET DEBUG_SYNC = 'wt_after_snapshot SIGNAL snapped WAIT_FOR go';
send CREATE WORKTREE wt FROM src;
connection default;
SET DEBUG_SYNC = 'now WAIT_FOR snapped';
--echo # files matching *.cf? in src and wt while quiesced:
--list_files $datadir/src *.cf?
--list_files $datadir/wt *.cf?
SET DEBUG_SYNC = 'now SIGNAL go';
connection con1;
reap;
disconnect con1;
connection default;
SET DEBUG_SYNC = 'RESET';
--echo # files matching *.cf? in src and wt afterwards:
--list_files $datadir/src *.cf?
--list_files $datadir/wt *.cf?

SHOW CREATE DATABASE wt;
SELECT NAME, ENCRYPTION FROM information_schema.INNODB_TABLESPACES WHERE NAME LIKE 'wt/%' ORDER BY NAME;
SHOW CREATE TABLE wt.e;
CHECKSUM TABLE src.e, src.ez, src.p;
CHECKSUM TABLE wt.e, wt.ez, wt.p;
CHECK TABLE wt.e, wt.ez, wt.p;

--echo # The worktree writes; its pages reach disk encrypted, with the shared key.
INSERT INTO wt.e VALUES (100000, 'worktree-secret-xyz', 1);
UPDATE wt.ez SET b = CONCAT('wt-', b) WHERE id <= 1000;
UPDATE src.e SET v = CONCAT('src-', v) WHERE id <= 10;
SET GLOBAL innodb_fast_shutdown = 0;
--source include/shutdown_mysqld.inc
perl;
  my $dd = $ENV{WT_DD};
  # Encryption info in page 0: after the XDES array (150 + 40 * physical / 64).
  sub info { my ($f, $ps) = @_; open(my $h, '<:raw', $f) or die "$f: $!"; my $p;
    sysread($h, $p, $ps); return substr($p, 150 + 40 * $ps / 64, 115); }
  sub has { my ($f, $s) = @_; open(my $h, '<:raw', $f) or die "$f: $!"; local $/; my $d = <$h>;
    return index($d, $s) >= 0 ? 'yes' : 'no'; }
  for my $t (['e', 16384], ['ez', 1024]) {
    my ($n, $ps) = @$t;
    my ($a, $b) = (info("$dd/src/$n.ibd", $ps), info("$dd/wt/$n.ibd", $ps));
    printf("%s: encryption info present: %s, tablespace key same as source: %s\n", $n,
           substr($b, 0, 3) =~ /^lC[A-C]$/ ? 'yes' : 'no', $a eq $b ? 'yes' : 'no');
    open(my $o, '>', "$ENV{MYSQLTEST_VARDIR}/tmp/info_$n") or die; print $o $b; close($o);
  }
  print "plaintext in wt/e.ibd: ", has("$dd/wt/e.ibd", 'plaintext-marker-'), "\n";
  print "worktree write in clear in wt/e.ibd: ", has("$dd/wt/e.ibd", 'worktree-secret-xyz'), "\n";
  print "plaintext in wt/ez.ibd: ", has("$dd/wt/ez.ibd", 'zmarker-'), "\n";
EOF
--source include/start_mysqld.inc
SELECT COUNT(*), SUM(v LIKE 'src-%'), SUM(v = 'worktree-secret-xyz') FROM src.e;
SELECT COUNT(*), SUM(v LIKE 'src-%'), SUM(v = 'worktree-secret-xyz') FROM wt.e;
SELECT SUM(b LIKE 'wt-%') FROM src.ez;
SELECT SUM(b LIKE 'wt-%') FROM wt.ez FORCE INDEX (kb);

--echo # Master key rotation re-encrypts the tablespace key in both files.
ALTER INSTANCE ROTATE INNODB MASTER KEY;
SET GLOBAL innodb_fast_shutdown = 0;
--source include/shutdown_mysqld.inc
perl;
  my $dd = $ENV{WT_DD};
  sub info { my ($f, $ps) = @_; open(my $h, '<:raw', $f) or die "$f: $!"; my $p;
    sysread($h, $p, $ps); return substr($p, 150 + 40 * $ps / 64, 115); }
  for my $t (['e', 16384], ['ez', 1024]) {
    my ($n, $ps) = @$t;
    open(my $i, '<', "$ENV{MYSQLTEST_VARDIR}/tmp/info_$n") or die; local $/; my $old = <$i>;
    my ($a, $b) = (info("$dd/src/$n.ibd", $ps), info("$dd/wt/$n.ibd", $ps));
    my ($ka, $kb, $ko) = map { unpack('N', substr($_, 3, 4)) } ($a, $b, $old);
    printf("%s: master key id src == wt: %s, rotated: %s\n", $n, $ka == $kb ? 'yes' : 'no',
           $kb != $ko && $b ne $old ? 'yes' : 'no');
  }
EOF
--source include/start_mysqld.inc
SET SESSION cte_max_recursion_depth = 100000;
CHECK TABLE src.e, src.ez, wt.e, wt.ez;
SELECT COUNT(*), SUM(v LIKE 'src-%'), SUM(v = 'worktree-secret-xyz') FROM wt.e FORCE INDEX (kv);
SELECT COUNT(*), SUM(b LIKE 'wt-%') FROM wt.ez FORCE INDEX (kb);
INSERT INTO wt.e VALUES (100001, 'after-rotation', 2);
INSERT INTO src.e VALUES (100001, 'src-after-rotation', 2);

--echo # A worktree of the worktree, after the rotation.
CREATE WORKTREE wt2 FROM wt;
--source include/restart_mysqld.inc
SELECT NAME, ENCRYPTION FROM information_schema.INNODB_TABLESPACES WHERE NAME LIKE 'wt2/%' ORDER BY NAME;
SELECT v FROM wt2.e WHERE id = 100001;
SELECT v FROM src.e WHERE id = 100001;
CHECKSUM TABLE wt.e, wt.ez;
CHECKSUM TABLE wt2.e, wt2.ez;
CHECK TABLE wt2.e, wt2.ez, wt2.p;

--echo # Page 0 of an encrypted worktree lost after a crash. Page 1 is encrypted
--echo # with the key that page 0 holds, so its map copy cannot name the file,
--echo # and identification falls back to InnoDB's page vote. Whatever the vote
--echo # makes of it (it may restore the worktree's own page 0 from the
--echo # doublewrite buffer, or stop with the file unidentified), it never
--echo # restores the source's page 0 into the worktree.
let WT_IBD = $datadir/wt/e.ibd;
let SRC_IBD = $datadir/src/e.ibd;
call mtr.add_suppression("Header page consists of zero bytes in datafile: ./wt/e.ibd");
# The background server may still hold the datadir lock briefly after it
# aborts; the next start retries it.
call mtr.add_suppression("Unable to lock ./ibdata1 error: 11");
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO src.e WITH RECURSIVE s(n) AS (SELECT 200000 UNION ALL SELECT n + 1 FROM s WHERE n < 220000)
  SELECT n, CONCAT('more-', n), n % 7 FROM s;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
UPDATE wt.e SET v = 'enc-after-checkpoint' WHERE id = 5;
--source include/kill_mysqld.inc
--copy_file $WT_IBD $MYSQLTEST_VARDIR/tmp/wt_e.ibd.saved
perl;
  my $f = $ENV{WT_IBD}; open(my $fh, '+<:raw', $f) or die "$f: $!";
  sysseek($fh, 0, 0); syswrite($fh, "\0" x 16384); close($fh);
EOF
let E_LOG = $MYSQLTEST_VARDIR/log/encryption_page0.err;
--exec_in_background $MYSQLD_CMD --log-error=$E_LOG --log-error-verbosity=3
let MYSQLD_SOCK = $MASTER_MYSOCK;
perl;
  # Wait for startup to finish either way; stop the server if it came up.
  my ($log, $up) = ($ENV{E_LOG}, 0);
  for (1 .. 600) {
    my $t = -e $log ? do { local (@ARGV, $/) = $log; <> } : '';
    if ($t =~ /ready for connections/) { $up = 1; last; }
    last if $t =~ /Aborting|Shutdown complete/;
    select(undef, undef, undef, 0.2);
  }
  system("$ENV{MYSQLADMIN} -uroot -S $ENV{MYSQLD_SOCK} shutdown >/dev/null 2>&1") if $up;
  # Until the process has exited: it holds the datadir's file locks until then.
  for (1 .. 300) { my $t = do { local (@ARGV, $/) = $log; <> }; last if $t =~ /MySQL Server - end/;
    select(undef, undef, undef, 0.2); }
  sleep(2);
  sub space_id { my $f = shift; open(my $fh, '<:raw', $f) or die; my $p; sysread($fh, $p, 16384); return unpack('N', substr($p, 34, 4)); }
  print "source page 0 written into the worktree: ", (space_id($ENV{WT_IBD}) == space_id($ENV{SRC_IBD}) ? "YES" : "no"), "\n";
  # Refused: put the file back so that recovery can run. Recovered: the
  # worktree already has its own page 0 and its redo applied; keep it.
  my $saved = "$ENV{MYSQLTEST_VARDIR}/tmp/wt_e.ibd.saved";
  if (!$up) { require File::Copy; File::Copy::copy($saved, $ENV{WT_IBD}) or die "restore: $!"; }
  unlink($saved) or die "$saved: $!";
EOF
--remove_file $E_LOG
--source include/start_mysqld.inc
SELECT v FROM wt.e WHERE id = 5;
SELECT COUNT(*) FROM src.e;
CHECK TABLE wt.e, src.e;

--echo # Control: stock FOR EXPORT does write them, and the listing shows them.
--echo # (In overlay mode src was frozen; MATERIALIZE makes it stock-format.)
ALTER WORKTREE src MATERIALIZE;
FLUSH TABLES src.e FOR EXPORT;
--list_files $datadir/src *.cf?
UNLOCK TABLES;

DROP DATABASE wt2;
DROP DATABASE wt;
DROP DATABASE src;
--remove_file $MYSQLTEST_VARDIR/tmp/info_e
--remove_file $MYSQLTEST_VARDIR/tmp/info_ez
let $do_not_echo_parameters = 0;
--source suite/component_keyring_file/inc/teardown_component.inc
